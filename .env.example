# ==============================================================================
# IMNID Hub - Global Environment Configuration
# ==============================================================================

# Application Environment (development | production)
# In development mode, mock/demo simulation triggers are enabled.
APP_ENV=production

# Initial Administrator Credentials
# On first launch, the admin account is initialized with this password.
# The user will be required to change this password on their first login.
ADMIN_INITIAL_PASSWORD=ChangeMeNow123!

# Application Ports
FRONTEND_PORT=3000
BACKEND_PORT=8085
MEDIATOR_PORT=8000

# Security & Encryption
JWT_SECRET=imnid-hub-super-secure-production-jwt-key-2026-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_SECRET_KEY=imnid-hub-encryption-secret-key-32chars!

# DHIS2 Online Server (Central / Target)
DHIS2_ONLINE_URL=https://imnid.aau.edu.et/dhis
DHIS2_ONLINE_USERNAME=admin
DHIS2_ONLINE_PASSWORD=YourOnlineDHIS2PasswordHere

# DHIS2 Offline Server (Local / Facility / Source)
DHIS2_OFFLINE_URL=http://host.docker.internal:8080/dhis
DHIS2_OFFLINE_USERNAME=admin
DHIS2_OFFLINE_PASSWORD=YourOfflineDHIS2PasswordHere

# DHIS2 MOH Aggregate Server (National Central Server)
DHIS2_MOH_URL=https://dhis.moh.gov.et
DHIS2_MOH_USERNAME=kbrom
DHIS2_MOH_PASSWORD=YourMohDHIS2PasswordHere

# Default DHIS2 Tracker Server (Legacy / Alias)
DHIS2_URL=https://imnid.aau.edu.et/dhis
DHIS2_USERNAME=admin
DHIS2_PASSWORD=YourDHIS2PasswordHere

# OpenMRS 3.x Server
# NOTE: Inside Docker containers, "localhost" resolves to the container itself.
# To reach an OpenMRS instance running on your host machine, use "http://host.docker.internal:8080/openmrs"
# or use the host's actual LAN/WAN IP address (e.g. http://192.168.1.50:8080/openmrs).
OPENMRS_URL=http://host.docker.internal:8080/openmrs
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=YourOpenMRSPasswordHere

# Bahmni 0.93 Server
# NOTE: Inside Docker containers, use "http://host.docker.internal:8080/openmrs" or the LAN IP of the Bahmni server.
BAHMNI_URL=http://host.docker.internal:8080/openmrs
BAHMNI_USERNAME=admin
BAHMNI_PASSWORD=YourBahmniPasswordHere

# REDCap Server
REDCAP_URL=https://redcap.example.org/api/
REDCAP_TOKEN=

# Internal Service Networking (Docker Bridge)
MEDIATOR_URL=http://mediator:8000
BACKEND_URL=http://backend:8085
DATA_DIR=/data
